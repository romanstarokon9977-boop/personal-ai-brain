# ============================================================
# PERSONAL AI BRAIN — .gitignore
# ============================================================

# --- Секреты ---
.env
.env.*
config.py

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Node / MCP ---
node_modules/
mcp_servers/*/node_modules/

# --- Локальные backup ---
.backups/

# --- Логи и временные файлы ---
*.log
*.tmp
/tmp/

# --- Локальное состояние ---
.last_briefing_date
router_stats.json
tasks.json
module_state.json
module_state.json.corrupt_*
module_state.json.tmp.stale_*

# --- Audit: архивы локально, текстовые материалы можно хранить в git ---
audit/*.tar.gz
audit/*.tar.gz.sha256

# --- Runtime-артефакты тестов ---
suite_*/
suite_runtests/

# --- Архивы и сжатые результаты ---
*.tar.gz
*.tar.gz.sha256

# --- PRE / GOLDEN / история ---
*_PRE_*.py
*_PRE_*.sh
*_PRE_*.json
*GOLDEN*
*.bak
*.bak_*
*.backup.*
backups_golden/
backups_memory/

# --- Memory: исторические PRE / BACKUP / legacy state ---
memory/*_PRE*.py
memory/*_PRE*.json
memory/*_BACKUP*.py
memory/*_BACKUP*.json
memory/*.bak*
memory/*.backup*
memory/memory.json

# --- Диагностика ---
diag_lock_persists/
/diag_lock_persists.sh
/diag_lock_persists_BACKUP_*.sh
.sched_probe.sh
cleanup_llama.sh
cheat_sheet.sh
brain_diagnostic*.txt
brain_state_snapshot*.log
qwen_second_*.json
tool_test.txt
edit_guard_test.txt
full_tool_test.txt
test_chat_write.txt
test_drive_tmp.txt
test_write_output.txt
300.

# --- Исторические / экспериментальные тесты ---
test_qwen_prompt_tool_loop*.py
test_qwen_second.py
test_file_edit_target.py

# --- Одноразовые исторические патчеры ---
apply_gemini_routing.py
patch_sec.py

# --- Установочные пакеты ---
*.deb

# --- Income Brain отчёты ---
income_reports/

# --- IDE / системный мусор ---
.vscode/
.idea/
.DS_Store
audit/20260923_075030_MEMORY_RECALL_AUDIT/recall_results.txt
